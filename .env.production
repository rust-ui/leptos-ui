# Values consumed by docker-compose.shared-server.yml (${DOCKER_USERNAME} etc.).
# The GitHub Actions deploy exports these from repo Variables at deploy time;
# this file is for running the same compose by hand on the server if needed.
# No secrets here — build-time secrets (RESEND_*, BUG_REPORTS_API_KEY) are baked
# into the image by the workflow via --build-arg.
DOCKER_USERNAME=everlabs
DOCKER_REPOSITORY=leptos-ui
IMAGE_TAG=latest
